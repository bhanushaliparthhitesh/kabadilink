# KabadiLink Environment Variables
# -----------------------------------------------------------------------------
# IMPORTANT: In Vite applications, only variables prefixed with VITE_ are
# statically embedded into the client-side JavaScript bundle at build time via
# `import.meta.env`. Because they are included in public build artifacts,
# NEVER put AWS secrets, access keys, or private tokens here.
# -----------------------------------------------------------------------------

# AWS API Gateway Base URL (AP South 1)
# Leave empty to run 100% in local offline demo mode without attempting AWS API calls.
VITE_API_BASE_URL=https://xzox8eatg9.execute-api.ap-south-1.amazonaws.com

# Demo / Mock Fallback Flag:
# Set to 'true' to allow falling back to local demo mock data when AWS API Gateway/Lambda fails or is unreachable.
# If set to 'false' (or omitted in strict production), API failures are shown honestly and mock data is NOT used.
VITE_ENABLE_DEMO_FALLBACK=true

# -----------------------------------------------------------------------------
# AWS Amplify Deployment Instructions:
# 1. In the AWS Amplify Console, navigate to:
#    App settings -> Environment variables
# 2. Add:
#    - Key: VITE_API_BASE_URL
#      Value: https://xzox8eatg9.execute-api.ap-south-1.amazonaws.com
#    - Key: VITE_ENABLE_DEMO_FALLBACK
#      Value: true
# 3. CRITICAL: Vite bakes these variables into the static dist bundle during `vite build`.
#    After adding or modifying environment variables in AWS Amplify, you MUST
#    trigger a new build/redeploy (e.g. click "Redeploy this version" under App build history
#    or push a git commit) for the changes to take effect.
# -----------------------------------------------------------------------------
